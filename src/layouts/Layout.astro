---
import "../styles/global.css";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" /><link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Anton&family=Montserrat:ital,wght@0,100..900;1,100..900&display=swap" rel="stylesheet">
    <meta name="generator" content={Astro.generator} />
    <title>Rodeo Del Desierto</title>
  </head>
  <body>
	<div class="fondo"></div>
    <slot />
  </body>
</html>

<style>
  html,
  body {
    margin: 0;
    padding: 0;
    width: 100%;
    height: 100%;
  
  }



  .fondo {
	position: fixed;
	top: 0;
	left: 0;
	width: 100%;
	height: 100%;
  background: rgb(87, 31, 12);
	background-image:
	  linear-gradient(rgba(0, 0, 0, 0.896), rgba(0, 0, 0, 0.85)),
	  url("/fondo_Desktop.avif");
	background-size: cover;
	background-position: center;
	z-index: -2;
  }
  @media (max-width: 768px) {
    .fondo {
      background-image:
        linear-gradient(rgba(0, 0, 0, 0.896), rgba(0, 0, 0, 0.899)),
        url("/fondo.avif");
    }
  }
</style>
