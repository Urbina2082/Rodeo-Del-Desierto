---
import InitSection from '../components/InitSection.astro';
import { ArrowUpRight } from '@lucide/astro';
---

<div class="mx-5 sm:mx-20 my-20" id="redes">

  <InitSection
    sub="REDES SOCIALES"
    title="SÍGUENOS EN NUESTRAS REDES SOCIALES"
    description="VIVE LA EXPERIENCIA DEL RODEO DEL DESIERTO"
  />

  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">

    <!-- FACEBOOK -->
    <a
      href="https://www.facebook.com/profile.php?id=100064156929938&locale=es_LA"
      target="_blank"
      rel="noopener noreferrer"
      class="group relative overflow-hidden flex flex-col p-7 rounded-2xl border border-white/10 bg-white/[0.02] backdrop-blur-md transition-all duration-300 hover:-translate-y-2 hover:border-amber-500/40 hover:bg-amber-500/[0.04] hover:shadow-xl hover:shadow-amber-900/20"
    >

      <div class="absolute -right-10 -top-10 w-32 h-32 bg-amber-500/10 blur-3xl rounded-full group-hover:bg-amber-500/20 transition-all"></div>

      <div class="relative flex items-center justify-between">
        <div class="w-14 h-14 flex items-center justify-center rounded-xl bg-amber-500/10 border border-amber-500/20 group-hover:bg-amber-500/20 transition-all">

          <svg viewBox="0 0 24 24" width="30" height="30" fill="#ffb84d">
            <path d="M14 13.5h2.5l1-4H14v-2c0-1.03 0-2 2-2h1.5V2.14c-.326-.043-1.557-.14-2.857-.14C11.928 2 10 3.657 10 6.7v2.8H7v4h3V22h4v-8.5z"/>
          </svg>

        </div>

        <ArrowUpRight
          size={22}
          strokeWidth={1.8}
          class="text-white/30 group-hover:text-amber-400 group-hover:translate-x-1 group-hover:-translate-y-1 transition-all duration-300"
        />
      </div>

      <div class="relative mt-8">
        <h3 class="text-white font-semibold tracking-wider">FACEBOOK</h3>
        <p class="text-white/40 text-sm mt-2 leading-relaxed">
          Entérate de nuestras novedades, eventos y próximas experiencias.
        </p>
      </div>

      <div class="relative mt-6 pt-4 border-t border-white/10">
        <span class="text-amber-400/80 text-xs tracking-widest">VISITAR PERFIL</span>
      </div>

    </a>


    <!-- TIKTOK -->
    <a
      href="https://www.tiktok.com/@rodeo.del.desierto"
      target="_blank"
      rel="noopener noreferrer"
      class="group relative overflow-hidden flex flex-col p-7 rounded-2xl border border-white/10 bg-white/[0.02] backdrop-blur-md transition-all duration-300 hover:-translate-y-2 hover:border-amber-500/40 hover:bg-amber-500/[0.04] hover:shadow-xl hover:shadow-amber-900/20"
    >

      <div class="absolute -right-10 -top-10 w-32 h-32 bg-amber-500/10 blur-3xl rounded-full group-hover:bg-amber-500/20 transition-all"></div>

      <div class="relative flex items-center justify-between">
        <div class="w-14 h-14 flex items-center justify-center rounded-xl bg-amber-500/10 border border-amber-500/20 group-hover:bg-amber-500/20 transition-all">

          <svg viewBox="0 0 24 24" width="30" height="30" fill="#ffb84d">
            <path d="M19.589 6.686a4.793 4.793 0 0 1-3.77-4.242V2h-3.445v13.672a2.896 2.896 0 0 1-5.201 1.743l-.002-.001.002.001a2.895 2.895 0 0 1 3.144-4.53v-3.5a6.341 6.341 0 0 0-5.234 5.845 6.335 6.335 0 0 0 10.537 4.718c1.378-1.229 2.251-3.033 2.251-5.045V8.98a8.196 8.196 0 0 0 4.722 1.483v-3.5a4.76 4.76 0 0 1-1.004-.277z"/>
          </svg>

        </div>

        <ArrowUpRight
          size={22}
          strokeWidth={1.8}
          class="text-white/30 group-hover:text-amber-400 group-hover:translate-x-1 group-hover:-translate-y-1 transition-all duration-300"
        />
      </div>

      <div class="relative mt-8">
        <h3 class="text-white font-semibold tracking-wider">TIKTOK</h3>
        <p class="text-white/40 text-sm mt-2 leading-relaxed">
          Disfruta los mejores momentos, videos y contenido del rodeo.
        </p>
      </div>

      <div class="relative mt-6 pt-4 border-t border-white/10">
        <span class="text-amber-400/80 text-xs tracking-widest">VISITAR PERFIL</span>
      </div>

    </a>


    <!-- INSTAGRAM -->
    <a
      href="https://www.instagram.com/rodeodeldesierto/"
      target="_blank"
      rel="noopener noreferrer"
      class="group relative overflow-hidden flex flex-col p-7 rounded-2xl border border-white/10 bg-white/[0.02] backdrop-blur-md transition-all duration-300 hover:-translate-y-2 hover:border-amber-500/40 hover:bg-amber-500/[0.04] hover:shadow-xl hover:shadow-amber-900/20"
    >

      <div class="absolute -right-10 -top-10 w-32 h-32 bg-amber-500/10 blur-3xl rounded-full group-hover:bg-amber-500/20 transition-all"></div>

      <div class="relative flex items-center justify-between">
        <div class="w-14 h-14 flex items-center justify-center rounded-xl bg-amber-500/10 border border-amber-500/20 group-hover:bg-amber-500/20 transition-all">

          <svg viewBox="0 0 24 24" width="30" height="30" fill="#ffb84d">
            <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
          </svg>

        </div>

        <ArrowUpRight
          size={22}
          strokeWidth={1.8}
          class="text-white/30 group-hover:text-amber-400 group-hover:translate-x-1 group-hover:-translate-y-1 transition-all duration-300"
        />
      </div>

      <div class="relative mt-8">
        <h3 class="text-white font-semibold tracking-wider">INSTAGRAM</h3>
        <p class="text-white/40 text-sm mt-2 leading-relaxed">
          Explora nuestras fotografías, momentos y experiencias.
        </p>
      </div>

      <div class="relative mt-6 pt-4 border-t border-white/10">
        <span class="text-amber-400/80 text-xs tracking-widest">VISITAR PERFIL</span>
      </div>

    </a>


    <!-- YOUTUBE -->
    <a
      href="https://www.youtube.com/@RodeoDelDesierto"
      target="_blank"
      rel="noopener noreferrer"
      class="group relative overflow-hidden flex flex-col p-7 rounded-2xl border border-white/10 bg-white/[0.02] backdrop-blur-md transition-all duration-300 hover:-translate-y-2 hover:border-amber-500/40 hover:bg-amber-500/[0.04] hover:shadow-xl hover:shadow-amber-900/20"
    >

      <div class="absolute -right-10 -top-10 w-32 h-32 bg-amber-500/10 blur-3xl rounded-full group-hover:bg-amber-500/20 transition-all"></div>

      <div class="relative flex items-center justify-between">
        <div class="w-14 h-14 flex items-center justify-center rounded-xl bg-amber-500/10 border border-amber-500/20 group-hover:bg-amber-500/20 transition-all">

          <svg viewBox="0 0 24 24" width="30" height="30" fill="#ffb84d">
            <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 23.498 6.186zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/>
          </svg>

        </div>

        <ArrowUpRight
          size={22}
          strokeWidth={1.8}
          class="text-white/30 group-hover:text-amber-400 group-hover:translate-x-1 group-hover:-translate-y-1 transition-all duration-300"
        />
      </div>

      <div class="relative mt-8">
        <h3 class="text-white font-semibold tracking-wider">YOUTUBE</h3>
        <p class="text-white/40 text-sm mt-2 leading-relaxed">
          Revive los eventos, presentaciones y videos del rodeo.
        </p>
      </div>

      <div class="relative mt-6 pt-4 border-t border-white/10">
        <span class="text-amber-400/80 text-xs tracking-widest">VISITAR CANAL</span>
      </div>

    </a>

  </div>
</div>
