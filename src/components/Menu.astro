---
import Button_Orange from "./Button_Orange.astro";
---

<div
  class="  mt-1 mx-12  text-white/60 inline-block absolute sm:relative right-0 sm:flex items-center justify-around backdrop-blur-sm bg-[#00000010] border-1 border-white/20 rounded-full py-2 px-8"
>
  <div class="sm:hidden">
    <svg
      xmlns="http://www.w3.org/2000/svg"
      width="24"
      height="24"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      class="lucide lucide-menu preview-icon"
      ><path d="M4 5h16"></path><path d="M4 12h16"></path><path d="M4 19h16"
      ></path></svg>
  </div>
  <div class="">
    <img
      src="/Logo_Rodeo_Del_Desierto.avif"
      alt="Logo"
      class="hidden sm:block w-49 flex"
    />
  </div>
  <nav>
    <ul class="hidden md:flex justify-center gap-12 text-sm montserrat ">
      <li><a href="/">INICIO</a></li>
      <li><a href="/about">EXPERIENCIA</a></li>
      <li><a href="/contact">CONTACTO</a></li>
    </ul>
  </nav>
  <div class="hidden md:block"><Button_Orange Text="BOLETOS" /></div>
</div>
