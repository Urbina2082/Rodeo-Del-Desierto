---
const { Text,enlace } = Astro.props;
---

<div class="">
<a 
  href={enlace} 
  class="inline-block bg-[#f4682b] bg-cover bg-center text-black/70 font-bold  text-sm px-8 py-2 rounded-full shadow-lg hover:opacity-95 transition-opacity text-center uppercase"
  style="background-image: linear-gradient(rgba(239, 105, 48, 0.85), rgba(181, 57, 3, 0.85)), url('/fondo.avif');"
>
  {Text}
</a>
</div>
